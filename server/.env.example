# Presales Tracker API — environment configuration
# Copy to server/.env and fill in real values. server/.env is gitignored.

# HTTP port the Express API listens on (behind nginx via /api)
PORT=4000

# PostgreSQL connection
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=presales
PGPASSWORD=CHANGE_ME_STRONG_PASSWORD
PGDATABASE=presales

# JWT signing secret (generate: openssl rand -hex 64)
JWT_SECRET=CHANGE_ME_RANDOM_64_HEX
JWT_EXPIRES_IN=12h

# Allowed CORS origin (leave empty when served same-origin behind nginx)
CORS_ORIGIN=

# Comma-separated bootstrap admin emails. On seed these users get role 'role-admin'.
ADMIN_EMAILS=athena.cole@presaleshq.io